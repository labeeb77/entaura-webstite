# Optional: the hosted demo shown on /try.html. Defaults to the current sample demo.
# VITE_ENTAURA_DEMO_URL=https://insight.dev.entaura.ai/demo/<demo-id>

# Contact form: a Web3Forms access key created for reachus@entaura.ai (web3forms.com).
# Without it, the form opens the visitor's email app instead.
# VITE_WEB3FORMS_KEY=

# Request a demo: the "Website embed" link of the Google Calendar appointment
# schedule (Share > Website embed > Inline booking page; copy the iframe's src),
# e.g. https://calendar.google.com/calendar/appointments/schedules/AcZss...?gv=true
# See booking/README.md. Without it, /demo.html asks visitors to email us.
# VITE_GOOGLE_CALENDAR_BOOKING_URL=
