# Optional: the hosted demo shown on /try.html. Defaults to the current sample demo.
# VITE_ENTAURA_DEMO_URL=https://insight.dev.entaura.ai/demo/<demo-id>

# Contact form: a Web3Forms access key created for reachus@entaura.ai (web3forms.com).
# Without it, the form opens the visitor's email app instead.
# VITE_WEB3FORMS_KEY=

# Request a demo: the Google Apps Script web app URL that books demo slots in
# Google Calendar (see booking/README.md). Without it, /demo.html collects the
# details and sends them through Web3Forms so the team can email a time.
# VITE_BOOKING_URL=https://script.google.com/macros/s/<deployment-id>/exec
