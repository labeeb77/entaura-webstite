# Optional: the hosted demo shown on /try.html. Defaults to the current sample demo.
# VITE_ENTAURA_DEMO_URL=https://insight.dev.entaura.ai/demo/<demo-id>

# Contact form: a Web3Forms access key created for reachus@entaura.ai (web3forms.com).
# Without it, the form opens the visitor's email app instead.
# VITE_WEB3FORMS_KEY=

# Optional: a different Google Calendar appointment schedule for /demo.html
# (Share > Website embed > Inline booking page; copy the iframe's src). The team's
# schedule is built in, so this is only needed to switch. See booking/README.md.
# VITE_GOOGLE_CALENDAR_BOOKING_URL=

# Optional: Google Apps Script web app that saves "Try Entaura" leads to a Google
# Sheet (see leads/README.md). Can also be set in src/data/leads.js.
# VITE_LEADS_SCRIPT_URL=https://script.google.com/macros/s/.../exec
